# ---------- Runtime ----------
FAST_MODE=0
TIMEZONE=Europe/Moscow
# Порт сервиса. 8080 на сервере занят java, 8000 — другим проектом.
APP_HOST=127.0.0.1
APP_PORT=8095
# Push (проактивные сообщения) только в этом окне; Pull (ответы) — всегда
PUSH_HOUR_START=9
PUSH_HOUR_END=19
FOLLOWUP_SILENCE_HOURS=4

# ---------- Wazzup ----------
WAZZUP_API_KEY=
# Свой секрет: попадает в URL вебхука /webhooks/wazzup/<secret>
WAZZUP_WEBHOOK_SECRET=
WAZZUP_API_BASE=https://api.wazzup24.com
# Публичный адрес сервиса (https), нужен для регистрации вебхука
PUBLIC_WEBHOOK_URL=
# Ретраи отправки при сети / 429 / 5xx
WAZZUP_SEND_RETRIES=3
WAZZUP_SEND_RETRY_BACKOFF_SEC=1.5

# ---------- amoCRM (кто уже общался → бот молчит) ----------
# Только чтение. Коннектор Wazzup сам пишет в amoCRM chatId под каждый канал
# (TelegramId_WZ, Avito_WZ, WhatsappLid_WZ, VK_WZ, ...) — оттуда и берём.
AMOCRM_BASE_URL=https://osipyan505.amocrm.ru
AMOCRM_TOKEN=REPLACE_WHEN_READY
AMOCRM_BASELINE_FILE=data/existing_baseline.txt
# Чаты, которые НИКОГДА не считаем старыми, даже если они есть в CRM.
# Тестовый телеграм уже завёл там контакт: без этой строки после
# пересоздания базы бот замолчал бы в собственном тестовом чате.
BASELINE_EXCLUDE_CHAT_IDS=7936875555
# Чат, которого нет в базе:
#   auto — доверять базе, но только если она загружена из amoCRM (дефолт)
#   open — всегда считать новым клиентом и отвечать
#   safe — всегда считать старым и молчать
FIRST_CONTACT_POLICY=auto
# Сколько старых чатов должно быть известно, чтобы поверить базе
BASELINE_MIN_CHATS=50
# Каналы без истории до бота — там незнакомый чат безопасно считать новым.
# Тестовый телеграм-бот именно такой.
FRESH_CHANNEL_IDS=8db980a2-eab3-48f5-bc9b-a93cb220c510
# Ответ владельца из MAX = перехват: дальше клиента ведёт он, бот молчит
MAX_REPLY_TAKES_OVER=1

# ---------- Тестовый режим ----------
# 1 — бот слушает ТОЛЬКО каналы из списков ниже, остальные молча игнорирует
TEST_MODE=1
# UUID каналов через запятую. Узнать: python -m scripts.wazzup_channels
TEST_CHANNEL_IDS=
# Либо по типу канала: telegram, whatsapp, avito, instagram, vk, max
TEST_CHAT_TYPES=
# 1 — писать в лог сырой payload вебхука (полезно на первом запуске)
LOG_RAW_WEBHOOK=1
# 0 — «сухой» прогон: ответ считается и пишется в лог, но клиенту НЕ уходит.
# По умолчанию 0: сервис поднимается немым, пока отправку не разрешили явно.
WAZZUP_SEND_ENABLED=0
# 1 — ручной ответ менеджера переводит чат в manual
STAFF_TAKEOVER_ON_ECHO=1

# ---------- Poe ----------
POE_API_KEY=
POE_BASE_URL=https://api.poe.com/v1
# Промпты залиты в ботов на Poe; код шлёт только runtime-контекст
POE_MANAGER_BOT=Vladimir_dialog
POE_CLASSIFIER_BOT=Vladimir_Intent
# 0 — промпты живут в самих ботах на Poe (рабочий режим).
# Файлы в prompts/ — исходники, их вставляют в ботов вручную.
SEND_SYSTEM_PROMPTS=0
HISTORY_LIMIT=40
CONFIDENCE_THRESHOLD=0.6

# ---------- MAX (позже) ----------
# Личный аккаунт: цена + Авито «номер без звонка»
# MAX Bot API. Пока MAX_ENABLED=0 бот в MAX не пишет вообще ничего.
MAX_BOT_TOKEN=
# chat_id рабочего чата — узнать: python -m scripts.max_chats
MAX_GROUP_ID=
MAX_ENABLED=0
# Сколько минут держится режим «сотрудник печатает ответ» после кнопки
MAX_AWAITING_TTL_MIN=60
# Чем MAX вправе беспокоить владельца: расчёты, файлы и Авито «показал номер».
# Авито включено: по такому событию владелец перезванивает клиенту сам.
MAX_NOTIFY_AVITO=1
# Алерты мониторинга (Poe отвалился, диск не пишется) — пока только в лог.
MAX_NOTIFY_HEALTH=0

# ---------- Персона ----------
COMPANY_NAME=А Ваша Мебель
MANAGER_NAME=Владимир

# ---------- Поведение ----------
REPLY_DELAY_MIN_SEC=5
REPLY_DELAY_MAX_SEC=8
MESSAGE_BATCH_WAIT_SEC=6
MESSAGE_BATCH_SETTLE_SEC=0.8
MESSAGE_BATCH_TAIL_WAIT_SEC=4
MESSAGE_BATCH_MAX_WAIT_SEC=30

# ---------- Голосовые ----------
# Голосовые: local (faster-whisper) | openai | poe | auto
TRANSCRIPTION_PROVIDER=auto
WHISPER_MODEL=small
OPENAI_API_KEY=
# Бот на Poe для распознавания, если провайдер poe
POE_WHISPER_BOT=Gemini-2.5-Flash
# Потолок на скачивание вложений клиента, байт
MEDIA_MAX_BYTES=26214400
# Потолок на расшифровку голосовых (сек / байт)
VOICE_MAX_SECONDS=90
VOICE_MAX_BYTES=3000000

# ---------- Эксплуатация ----------
BACKUP_ENABLED=1
BACKUP_DIR=data/backups
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24
HEALTH_WATCH_ENABLED=1
HEALTH_WATCH_INTERVAL_SEC=600
MAX_INBOX_LOCK_PATH=data/max_inbox.lock

# ---------- Vision ----------
VISION_ENABLED=1
VISION_API_URL=http://127.0.0.1:8090
VISION_TOP_K=5
# Вырезать фон перед сравнением. Требует rembg (+onnxruntime, ~500 МБ).
# Держите одинаковым с CUT_BG_ON_INDEX, иначе запрос и индекс несравнимы.
CUT_BG=false
CUT_BG_ON_INDEX=false
# Слать ли клиенту фото найденных позиций (нужен публичный PUBLIC_WEBHOOK_URL)
SEND_CATALOG_PHOTOS=1
CATALOG_PHOTOS_LIMIT=3
SIMILARITY_THRESHOLD=0.42
CUT_BG=true
# При индексации rembg сильно замедляет (часы на CPU). Для максимума: true.
# На запросе rembg всегда включён (CUT_BG=true) — клиентские фото с фоном комнаты.
CUT_BG_ON_INDEX=false
QDRANT_MODE=local
QDRANT_PATH=data/qdrant_local
QDRANT_COLLECTION=vasha_mebel
CATALOG_PATH=catalog

# ---------- Данные ----------
DB_PATH=data/bot.db
LOG_PATH=data/bot.log
