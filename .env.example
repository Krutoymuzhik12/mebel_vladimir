# ---------- Runtime ----------
FAST_MODE=0
TIMEZONE=Europe/Moscow
# Push (проактивные сообщения) только в этом окне; Pull (ответы) — всегда
PUSH_HOUR_START=9
PUSH_HOUR_END=18
FOLLOWUP_SILENCE_HOURS=4

# ---------- Wazzup (позже) ----------
WAZZUP_API_KEY=
WAZZUP_WEBHOOK_SECRET=
# Базовый URL API, уточним по доке при подключении
WAZZUP_API_BASE=https://api.wazzup24.com

# ---------- Poe ----------
POE_API_KEY=
POE_BASE_URL=https://api.poe.com/v1
POE_MANAGER_BOT=
POE_CLASSIFIER_BOT=
SEND_SYSTEM_PROMPTS=false
HISTORY_LIMIT=40
CONFIDENCE_THRESHOLD=0.6

# ---------- MAX (позже) ----------
# Личный аккаунт: цена + Авито «номер без звонка»
MAX_GROUP_ID=
MAX_ENABLED=0

# ---------- Персона ----------
COMPANY_NAME=А Ваша Мебель
MANAGER_NAME=Владимир

# ---------- Поведение ----------
REPLY_DELAY_MIN_SEC=5
REPLY_DELAY_MAX_SEC=8
MESSAGE_BATCH_WAIT_SEC=6
MESSAGE_BATCH_SETTLE_SEC=0.8
MESSAGE_BATCH_TAIL_WAIT_SEC=4
MESSAGE_BATCH_MAX_WAIT_SEC=30

# ---------- Голосовые (на будущее) ----------
TRANSCRIPTION_PROVIDER=auto
WHISPER_MODEL=small
OPENAI_API_KEY=

# ---------- Vision ----------
VISION_ENABLED=1
VISION_API_URL=http://127.0.0.1:8090
VISION_TOP_K=5
SIMILARITY_THRESHOLD=0.42
CUT_BG=true
# При индексации rembg сильно замедляет (часы на CPU). Для максимума: true.
# На запросе rembg всегда включён (CUT_BG=true) — клиентские фото с фоном комнаты.
CUT_BG_ON_INDEX=false
QDRANT_MODE=local
QDRANT_PATH=data/qdrant_local
QDRANT_COLLECTION=vasha_mebel
CATALOG_PATH=catalog

# ---------- Данные ----------
DB_PATH=data/bot.db
LOG_PATH=data/bot.log
