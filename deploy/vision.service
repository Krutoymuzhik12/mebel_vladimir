[Unit]
Description=Vladimir mebel vision (подбор по фото, DINOv2 + Qdrant)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/opt/vladimir
Environment=PYTHONUNBUFFERED=1
# 2 ядра на машине, больше потоков только съест память без выигрыша
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
# Отдельное окружение: torch тяжёлый, в основной venv ему делать нечего.
# Наружу не слушаем — ходит только основной сервис с этой же машины.
ExecStart=/var/opt/vladimir/.venv-vision/bin/python -m uvicorn app.vision.api:app --host 127.0.0.1 --port 8090
# Модель грузится в память при первом запросе, старт не мгновенный
TimeoutStartSec=300
# Потолок памяти: при утечке или всплеске ядро прибьёт именно vision, а не
# основной сервис. Подбор по фото — не критичная функция, бот переживёт его
# падение и честно скажет клиенту, что подбор недоступен.
# Поднимайте, если на машине памяти много: DINOv2 хочет около 900 МБ.
MemoryHigh=1G
MemoryMax=1500M
OOMPolicy=continue
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
